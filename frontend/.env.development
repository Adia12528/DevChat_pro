# Development Environment Configuration
# Enable Fast Refresh for instant updates
FAST_REFRESH=true

# Browser auto-opens when starting dev server
BROWSER=chrome

# Skip preflight check for faster startup
SKIP_PREFLIGHT_CHECK=true

# Enable source maps for better debugging
GENERATE_SOURCEMAP=true

# Disable service worker in development for instant updates
REACT_APP_SERVICE_WORKER_DISABLED=true

# Hot Module Replacement
WDS_SOCKET_PORT=0
