# Auto detect text files and perform LF normalization
* text=auto

# JavaScript files
*.js text eol=lf

# JSON files
*.json text eol=lf

# CSS files
*.css text eol=lf

# HTML files
*.html text eol=lf

# Markdown files
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.webmanifest binary