# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/devchat?retryWrites=true&w=majority
PORT=5000

# Logging level: silent | error | warn | info | debug
# Recommended: debug for local development, error for production
LOG_LEVEL=debug


# LiveKit
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret


# Firebase Admin SDK (Service Account)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_LINE_1\nYOUR_KEY_LINE_2\n...\n-----END PRIVATE KEY-----\n"